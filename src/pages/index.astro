---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import DoctorCard from "../components/DoctorCard.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import PripremaOporavak from "../components/PripremaOporavak.astro";
import PutLijecenja from "../components/PutLijecenja.astro";
import StickyCta from "../components/StickyCta.astro";
import SymptomGrid from "../components/SymptomGrid.astro";
import ZahvatIstaknuto from "../components/ZahvatIstaknuto.astro";
import { cta } from "../copy/cta";

const title = "Dječji ORL pregledi i operacije u Zagrebu | Mali ORL";
const description =
  "Od hrkanja i slabijeg sluha do odluke o zahvatu. Razumljive informacije za roditelje i individualna procjena djeteta u Zagrebu.";
---

<BaseLayout title={title} description={description} page="home">
  <Header page="home" />
  <main>
    <Hero />
    <ZahvatIstaknuto />
    <SymptomGrid />
    <PutLijecenja />
    <PripremaOporavak />
    <DoctorCard />
    <Faq />
    <CtaBand page="home" label={cta.pregledDijete} />
  </main>
  <Footer page="home" />
  <StickyCta page="home" />
</BaseLayout>
