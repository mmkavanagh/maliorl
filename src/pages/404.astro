---
import type { ImageMetadata } from "astro";
import nijePronadena from "../assets/og/nije-pronadena.svg";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SchemaJsonLd from "../components/SchemaJsonLd.astro";

const title = "Stranica nije pronađena | Mali ORL";
const description = "Tražena stranica ne postoji. Vratite se na početnu stranicu Mali ORL.";
const crumbs = [
  { name: "Početna", href: "/" },
  { name: "Stranica nije pronađena", href: "/404/" },
];
const ogImage = nijePronadena as ImageMetadata;
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogAlt={title} noindex>
  <SchemaJsonLd slot="head" title={title} description={description} crumbs={crumbs} />
  <section class="mx-auto max-w-5xl px-5 py-14 md:px-8 md:py-24">
    <Breadcrumbs items={crumbs} />
    <div class="mt-8 max-w-2xl rounded-3xl bg-sky px-6 py-12 md:px-12 md:py-16">
      <h1 class="text-5xl tracking-tight md:text-6xl">Stranica nije pronađena</h1>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-navy">Ova adresa ne vodi na stranicu.</p>
      <p class="mt-8">
        <a class="site-link" href="/">Natrag na početnu</a>
      </p>
    </div>
  </section>
</BaseLayout>
