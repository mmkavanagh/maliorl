---
import PlainLayout from "../layouts/PlainLayout.astro";
import { doctorUrl, sinusUrl } from "../config";
import { cta } from "../copy/cta";

const page = "o-lijecniku";
const href = doctorUrl(page);
const sinusi = sinusUrl();
---

<PlainLayout
  title="O liječniku | Mali ORL"
  description="Prim. Marcel Marjanović Kavanagh, specijalist otorinolaringologije. Radi u KBC-u Zagreb i predaje na Medicinskom fakultetu Sveučilišta u Zagrebu."
  h1="O liječniku"
  lead="Specijalist otorinolaringologije i subspecijalist plastične i rekonstruktivne kirurgije glave i vrata."
  page={page}
  tone="lilac"
>
  <div class="doctor">
    <div class="portrait" aria-hidden="true">
      <svg viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="94" fill="none" stroke="#FFC94A" stroke-width="6" stroke-dasharray="2 14" stroke-linecap="round"></circle>
        <circle cx="178" cy="46" r="10" fill="#FF7A6B"></circle>
        <circle cx="20" cy="140" r="8" fill="#3FBF94"></circle>
        <circle cx="160" cy="176" r="6" fill="#4FB3E8"></circle>
      </svg>
      <div class="ph">MMK</div>
    </div>
    <div>
      <p>
        <a class="site-link" href={href}><strong>Prim. Marcel Marjanović Kavanagh, univ.mag.med.</strong></a>, specijalist je otorinolaringologije i subspecijalist plastične i rekonstruktivne kirurgije glave i vrata. Radi na Klinici za otorinolaringologiju i kirurgiju glave i vrata KBC-a Zagreb i predaje na Medicinskom fakultetu Sveučilišta u Zagrebu.
      </p>
      <p>Posebnu pažnju posvećuje tome da roditelji razumiju dijagnozu i sve mogućnosti liječenja prije bilo kakve odluke.</p>
      <p><a class="site-link" href={sinusi}>Centar za sinuse</a> je srodna stranica o sinusima i alergiji.</p>
      <div class="tags"><span>Nos i sinusi</span><span>Treći krajnik i krajnici</span><span>Uši i sluh</span></div>
      <a class="btn soft" href={href}>{cta.lijecnik} →</a>
    </div>
  </div>
</PlainLayout>
