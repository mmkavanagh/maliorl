---
import { getCollection } from "astro:content";
import HubPage from "../../components/HubPage.astro";
import { NAZIVI } from "../../lib/published";

const featured = [
  { id: "adenoidektomija", title: "Endoskopska operacija trećeg krajnika" },
  { id: "ventilacijske-cjevcice", title: "Ventilacijske cjevčice u ušima" },
  { id: "frenulotomija", title: "Kratka podjezična resica" },
];
const quietOrder = ["vadenje-krajnika", "polipi-i-nosne-skoljke"];

const all = await getCollection("zahvati");

function cardFor(id: string, title?: string) {
  const entry = all.find((item) => item.id === id && item.data.obavljaSe);
  if (!entry) return [];
  const href = `/zahvati/${entry.id}/`;
  return [
    {
      href,
      title: title ?? NAZIVI[href] ?? entry.data.h1,
      text: entry.data.ukratko[0],
    },
  ];
}

const cards = featured.flatMap((item) => cardFor(item.id, item.title));
const quietCards = quietOrder.flatMap((id) => cardFor(id));
---

<HubPage
  title="Operacije i zahvati | Mali ORL"
  description="Endoskopska operacija trećeg krajnika, ventilacijske cjevčice i podjezična resica. Pregled može završiti praćenjem, liječenjem bez zahvata ili preporukom zahvata."
  h1="Operacije i zahvati"
  lead="Istaknuti su endoskopska operacija trećeg krajnika, ventilacijske cjevčice i podjezična resica. Pregled može završiti praćenjem, liječenjem bez zahvata ili preporukom zahvata. Procjena je individualna."
  tone="lilac"
  chip="Zahvati"
  page="zahvati"
  cards={cards}
  quietTitle="Ostali zahvati"
  quietLead="Ove stranice već postoje. I o njima se odluka donosi na pregledu, ne kao prvi korak iz ovog popisa."
  quietCards={quietCards}
  markLead
/>
