---
import { getCollection } from "astro:content";
import HubPage from "../../components/HubPage.astro";
import { NAZIVI } from "../../lib/published";

const order = ["adenoidektomija", "ventilacijske-cjevcice"];
const all = await getCollection("zahvati");
const cards = order.flatMap((id) => {
  const entry = all.find((item) => item.id === id && item.data.obavljaSe);
  if (!entry) return [];
  const href = `/zahvati/${entry.id}/`;
  return [{ href, title: NAZIVI[href] ?? entry.data.h1, text: entry.data.ukratko[0] }];
});
---

<HubPage
  title="Zahvati u dječjoj ORL | Mali ORL"
  description="Zahvati o kojima pišemo: operacija trećeg krajnika i ventilacijske cjevčice. Kada se razmatraju, što očekivati na dan zahvata i kako izgleda oporavak."
  h1="Zahvati u dječjoj ORL"
  lead="Ovdje su operacija trećeg krajnika i ventilacijske cjevčice. Na svakoj stranici piše kada zahvat ima smisla, što radi anesteziolog i što pitati na konzultaciji."
  tone="lilac"
  chip="Zahvati"
  page="zahvati"
  cards={cards}
/>
