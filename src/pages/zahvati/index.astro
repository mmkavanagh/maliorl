---
import { getCollection } from "astro:content";
import HubPage from "../../components/HubPage.astro";
import { NAZIVI } from "../../lib/published";

const order = [
  "adenoidektomija",
  "vadenje-krajnika",
  "ventilacijske-cjevcice",
  "frenulotomija",
  "polipi-i-nosne-skoljke",
];
const all = await getCollection("zahvati");
const cards = order.flatMap((id) => {
  const entry = all.find((item) => item.id === id && item.data.obavljaSe);
  if (!entry) return [];
  const href = `/zahvati/${entry.id}/`;
  return [{ href, title: NAZIVI[href] ?? entry.data.h1, text: entry.data.ukratko[0] }];
});
---

<HubPage
  title="Zahvati u dječjoj ORL | Mali ORL"
  description="Zahvati: endoskopski treći krajnik, krajnici, cjevčice, podjezična resica te polipi i nosne školjke. Na stranici piše kada zahvat ima smisla."
  h1="Zahvati u dječjoj ORL"
  lead="Pet zahvata: endoskopsko vađenje trećeg krajnika, krajnici, cjevčice u uhu, podjezična resica te polipi i nosne školjke. Na svakoj stranici piše kada zahvat ima smisla i što pitati na konzultaciji."
  tone="lilac"
  chip="Zahvati"
  page="zahvati"
  cards={cards}
/>
