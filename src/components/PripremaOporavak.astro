---
const stavke = [
  {
    href: "/za-roditelje/#priprema",
    naslov: "Priprema djeteta",
    tekst: "Kratke istinite rečenice i što ponijeti. Jelo i piće kaže anesteziolog.",
  },
  {
    href: "/za-roditelje/#anestezija",
    naslov: "Pitanja za anesteziologa",
    tekst: "Od kada bez jela, što s redovitim lijekom i tko je uz dijete dok zaspe.",
  },
  {
    href: "/za-roditelje/#dan-zahvata",
    naslov: "Dan zahvata",
    tekst: "Dolazak, san, buđenje i odluka o otpustu. Isti dan kući nije pravilo za svako dijete.",
  },
  {
    href: "/za-roditelje/#oporavak",
    naslov: "Oporavak po zahvatu",
    tekst: "Upute su uz svaku operaciju, ne u jednoj tablici za sve.",
  },
];

const zahvati = [
  { href: "/zahvati/adenoidektomija/", naziv: "Endoskopska operacija trećeg krajnika" },
  { href: "/zahvati/ventilacijske-cjevcice/", naziv: "Ventilacijske cjevčice" },
  { href: "/zahvati/frenulotomija/", naziv: "Podjezična resica" },
];
---

<section class="block" id="priprema">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2>Priprema i oporavak</h2>
        <p class="lead" style="margin:0">Priprema, pitanja za anesteziologa i dan zahvata skupljeni su za roditelje. Oporavak čitajte uz zahvat koji je dogovoren.</p>
      </div>
    </div>
    <ul class="prep">
      {
        stavke.map((stavka) => (
          <li>
            <a href={stavka.href}>{stavka.naslov}</a>
            <p>{stavka.tekst}</p>
          </li>
        ))
      }
    </ul>
    <p class="links">
      {zahvati.map((zahvat) => (
        <a class="pill" href={zahvat.href}>{zahvat.naziv}</a>
      ))}
    </p>
  </div>
</section>
