---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "./CtaBand.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import StickyCta from "./StickyCta.astro";
import Wave from "./Wave.astro";
import { cta } from "../copy/cta";
import { hubJsonLd } from "../lib/schema";

interface Card {
  href: string;
  title: string;
  text: string;
}

interface Block {
  title: string;
  lead?: string;
  cards: Card[];
}

interface Props {
  title: string;
  description: string;
  h1: string;
  lead: string;
  tone: "coral" | "mint" | "lilac";
  chip: string;
  page: string;
  cards: Card[];
  quietTitle?: string;
  quietLead?: string;
  quietCards?: Card[];
  blocks?: Block[];
  markLead?: boolean;
}

const { title, description, h1, lead, tone, chip, page, cards, quietTitle, quietLead, quietCards = [], blocks = [], markLead = false } = Astro.props;
const dot = tone === "coral" ? "dot-coral" : tone === "mint" ? "dot-mint" : "dot-lilac";
const grid =
  tone === "coral" ? "tone-coral" : tone === "mint" ? "tone-mint" : "tone-lilac";
---

<BaseLayout title={title} description={description} page={page} jsonLd={[hubJsonLd({ slug: page, h1 })]}>
  <Header page={page} razlog="opce" />
  <main>
    <section class:list={["hero", tone, "article"]}>
      <div class="wrap">
        <nav class="crumbs" aria-label="Put">
          <a href="/">Početna</a>
          <span aria-hidden="true">/</span>
          <span>{h1}</span>
        </nav>
        <p class="chip"><i class={dot}></i> {chip}</p>
        <h1>{h1}</h1>
        <p class="lead hub-lead">
          {lead}
          {markLead && <Fragment set:html={"<!-- PROVJERITI -->"} />}
        </p>
      </div>
      <Wave viewBox="0 0 1440 70" d="M0 40c120-30 240-30 360 0s240 30 360 0 240-30 360 0 240 30 360 0v30H0z" />
    </section>
    <section class="block">
      <div class="wrap">
        <div class:list={["cards", cards.length === 3 ? "tri" : "", grid]}>
          {
            cards.map((card) => (
              <a class="card" href={card.href}>
                <span class="go">→</span>
                <strong>{card.title}</strong>
                <small>{card.text}</small>
              </a>
            ))
          }
        </div>
        {
          quietCards.length > 0 && (
            <div class="quiet-block">
              <h2>{quietTitle}</h2>
              {quietLead && <p class="lead">{quietLead}</p>}
              <ul class="quiet-list">
                {quietCards.map((card) => (
                  <li>
                    <a href={card.href}>{card.title}</a>
                    <span> — {card.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          blocks.map((block) => (
            <div class="quiet-block">
              <h2>{block.title}</h2>
              {block.lead && <p class="lead">{block.lead}</p>}
              <ul class="quiet-list">
                {block.cards.map((card) => (
                  <li>
                    <a href={card.href}>{card.title}</a>
                    <span> — {card.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
    <CtaBand page={page} razlog="opce" label={cta.termin} />
  </main>
  <Footer page={page} />
  <StickyCta page={page} razlog="opce" />
</BaseLayout>
