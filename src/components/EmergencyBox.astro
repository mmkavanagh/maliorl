---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

{
  Astro.slots.has("default") && (
    <aside class="rounded-2xl border border-gold bg-cream px-6 py-8 md:px-10">
      {title && <h2 class="font-serif text-2xl font-semibold text-navy">{title}</h2>}
      <div class:list={[title && "mt-4"]}>
        <slot />
      </div>
    </aside>
  )
}
