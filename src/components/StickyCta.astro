---
import BookingCta from "./BookingCta.astro";
import { cta } from "../copy/cta";

interface Props {
  page?: string;
  razlog?: string;
}

const { page = "home", razlog = "opce" } = Astro.props;
---

<BookingCta class="sticky" page={page} position="sticky" razlog={razlog} label={cta.pregled} arrow />
