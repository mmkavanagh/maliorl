---
interface Props {
  items?: string[];
  class?: string;
}

const defaultItems = [
  "Redovito hrkanje kod djeteta (više noći tjedno) nije bezazleno i razlog je za pregled.",
  "Najčešći uzrok začepljenog nosa i disanja na usta u vrtićkoj dobi je povećan treći krajnik.",
  "Tekućina iza bubnjića često prolazi sama, ali ako traje mjesecima može utjecati na sluh i govor.",
  "Većina problema rješava se bez operacije. Kada je zahvat potreban, dijete u pravilu ide kući isti dan.",
];

const { items = defaultItems, class: className } = Astro.props;
---

<div class="wrap">
  <aside class:list={["summary", className]}>
    <div class="badge">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#1f8fcb" stroke-width="2.2" stroke-linecap="round">
        <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z"></path>
      </svg>
    </div>
    <div>
      <h2>Ukratko</h2>
      <ul>
        {items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </aside>
</div>
