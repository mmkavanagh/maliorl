---
interface Item {
  href: string;
  title: string;
  text?: string;
}

interface Props {
  items?: Item[];
}

const { items = [] } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="grid gap-4 sm:grid-cols-2">
      {items.map((item) => (
        <li>
          <a class="block rounded-3xl border border-gold bg-cream px-6 py-6" href={item.href}>
            <span class="site-link">{item.title}</span>
            {item.text && <span class="mt-2 block text-navy">{item.text}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}
