---
import { bookingUrl } from "../config";
import { bookingRazlog } from "../lib/booking";

interface Props {
  page: string;
  position: "header" | "hero" | "inline" | "kraj" | "sticky" | "kviz-a" | "kviz-b" | "kviz-c";
  label: string;
  arrow?: boolean;
  soft?: boolean;
  class?: string;
}

const { page, position, label, arrow = false, soft = false, class: className = "" } = Astro.props;
const razlog = bookingRazlog(page);
const href = bookingUrl({ page, position });
const classes = ["btn", soft ? "soft" : "", className].filter(Boolean).join(" ");
---

<a
  class={classes}
  href={href}
  data-track="cta"
  data-page={page}
  data-position={position}
  data-razlog={razlog}
>
  {label}{arrow ? " →" : ""}
</a>
