---
import { bookingUrl } from "../config";
import { cta } from "../copy/cta";

const href = bookingUrl({ page: "home", position: "header", razlog: "opce" });
---

<header class="site">
  <div class="wrap">
    <a class="logo" href="/" aria-label="Mali ORL – početna">
      <span class="dot"><i></i></span>
      <span>mali <b>O</b><b>R</b><b>L</b></span>
    </a>
    <nav class="main" aria-label="Glavna navigacija">
      <a href="#simptomi">Simptomi</a>
      <a href="#treci-krajnik">Treći krajnik</a>
      <a href="#pregled">Pregled</a>
      <a href="#pitanja">Pitanja</a>
    </nav>
    <a class="btn" href={href}>{cta.termin}</a>
  </div>
</header>
