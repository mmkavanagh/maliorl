---
import BookingCta from "./BookingCta.astro";
import { cta } from "../copy/cta";

interface Props {
  page?: string;
}

const { page = "home" } = Astro.props;

const links = [
  { href: "/simptomi/", label: "Simptomi" },
  { href: "/stanja/", label: "Stanja" },
  { href: "/zahvati/", label: "Operacije i zahvati" },
  { href: "/pregled-i-endoskopija/", label: "Pregled i endoskopija" },
  { href: "/za-roditelje/", label: "Za roditelje" },
  { href: "/o-lijecniku/", label: "O liječniku" },
];

const path = Astro.url.pathname;
---

<header class="site">
  <div class="wrap">
    <a class="logo" href="/" aria-label="Mali ORL – početna">
      <span class="dot"><i></i></span>
      <span>mali <b>O</b><b>R</b><b>L</b></span>
    </a>
    <details class="nav-drawer" id="nav-drawer" open>
      <summary class="nav-toggle">Izbornik</summary>
      <nav class="main" id="glavna-navigacija" aria-label="Glavna navigacija">
        {
          links.map((link) => (
            <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
        <BookingCta class="nav-book" page={page} position="header" label={cta.pregled} />
      </nav>
    </details>
    <BookingCta page={page} position="header" label={cta.pregled} />
  </div>
  <script is:inline>
    (function () {
      var drawer = document.getElementById("nav-drawer");
      if (!drawer || !window.matchMedia) return;
      var wide = window.matchMedia("(min-width: 921px)");
      var sync = function () {
        if (wide.matches) drawer.setAttribute("open", "");
        else drawer.removeAttribute("open");
      };
      sync();
      if (wide.addEventListener) wide.addEventListener("change", sync);
    })();
  </script>
</header>
