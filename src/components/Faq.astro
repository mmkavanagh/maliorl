---
interface Item {
  q: string;
  a: string;
}

interface Props {
  items?: Item[];
}

const { items = [] } = Astro.props;
---

{
  items.length > 0 && (
    <section class="flex flex-col gap-3">
      {items.map((item) => (
        <details class="rounded-2xl border border-gold bg-cream px-5 py-4">
          <summary class="cursor-pointer font-medium text-navy">{item.q}</summary>
          <p class="mt-3 text-navy">{item.a}</p>
        </details>
      ))}
    </section>
  )
}

<style>
  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::marker {
    content: "";
  }
</style>
