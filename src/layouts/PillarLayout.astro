---
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import AuthorBox from "../components/AuthorBox.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBlock from "../components/CtaBlock.astro";
import EmergencyBox from "../components/EmergencyBox.astro";
import Faq from "../components/Faq.astro";
import RelatedCards from "../components/RelatedCards.astro";
import SchemaJsonLd from "../components/SchemaJsonLd.astro";
import SummaryBox from "../components/SummaryBox.astro";
import type { Crumb } from "../lib/schema";

interface FaqItem {
  q: string;
  a: string;
}

interface RelatedItem {
  href: string;
  title: string;
  text?: string;
}

interface Props {
  title: string;
  description: string;
  crumbs: Crumb[];
  ogImage?: ImageMetadata;
  ogAlt?: string;
  faq?: FaqItem[];
  related?: RelatedItem[];
}

const { title, description, crumbs, ogImage, ogAlt, faq = [], related = [] } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogAlt={ogAlt}>
  <SchemaJsonLd slot="head" title={title} description={description} crumbs={crumbs} includeAuthor />
  <article class="mx-auto flex max-w-5xl flex-col gap-10 px-5 py-14 md:px-8 md:py-24">
    <Breadcrumbs items={crumbs} />
    <header>
      <h1 class="text-5xl tracking-tight md:text-6xl"><slot name="heading" /></h1>
    </header>
    <SummaryBox><slot name="summary" /></SummaryBox>
    <EmergencyBox><slot name="emergency" /></EmergencyBox>
    <div class="max-w-2xl">
      <slot />
    </div>
    <Faq items={faq} />
    <AuthorBox />
    <RelatedCards items={related} />
    <CtaBlock />
  </article>
</BaseLayout>
