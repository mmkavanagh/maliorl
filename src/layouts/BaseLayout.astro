---
import "../styles/global.css";
import { ANALYTICS_DOMAIN, ANALYTICS_SRC, SITE } from "../config";
import { globalJsonLd } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  page: string;
  jsonLd?: unknown[];
  noindex?: boolean;
}

const { title, description, page, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const blocks = [globalJsonLd(), ...jsonLd];
---

<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hr_HR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      blocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    {ANALYTICS_DOMAIN && ANALYTICS_SRC && <script async src={ANALYTICS_SRC} data-domain={ANALYTICS_DOMAIN} />}
  </head>
  <body data-page={page}>
    <slot />
    <script>
      import { track } from "../scripts/analytics";

      document.addEventListener("click", (event) => {
        const target = event.target;
        const el = target instanceof Element ? target.closest("[data-track='cta']") : null;
        if (!(el instanceof HTMLElement)) return;
        track("cta_klik", {
          page: el.dataset.page,
          position: el.dataset.position,
          razlog: el.dataset.razlog,
        });
      });

      document.addEventListener(
        "toggle",
        (event) => {
          const el = event.target;
          if (!(el instanceof HTMLDetailsElement) || !el.open) return;
          const pitanje = el.querySelector("summary")?.textContent?.trim() ?? "";
          track("faq_otvoren", {
            page: document.body.dataset.page,
            pitanje,
          });
        },
        true,
      );
    </script>
  </body>
</html>
